# Borynx environment variables
#
# Two builds share this repository:
#   - Vite app (npm run dev / npm run build)  -> VITE_* variables
#   - Next.js App Router (npm run dev:next)   -> NEXT_PUBLIC_* variables
# Public Storage variables use build prefixes; server credentials MUST NOT.
#
# Supabase Storage public configuration (Auth retired); retained compatibility credentials (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Storage public configuration (Auth retired); retained compatibility credentials (Vite)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Deprecated flags: true only logs a warning; mock database/identities are retired.
NEXT_PUBLIC_DEMO_MODE=false
VITE_DEMO_MODE=false

# Neon PostgreSQL (server-only, Phase 2B.1)
#
# NOT prefixed NEXT_PUBLIC_ / VITE_: this is a database credential and must
# never reach the browser bundle. Leave it unset for unconfigured
# builds — the app then reports "database not configured" instead of failing.
# Use the pooled connection string (`-pooler` host) on serverless deployments.
# Local development: any PostgreSQL, e.g. postgres://user:pass@127.0.0.1:5432/borynx
#
# TLS: remote hosts are ALWAYS certificate-verified. Any sslmode / sslrootcert /
# sslcert parameter in this URL is ignored (stripped) so it cannot weaken that.
# Neon needs no extra configuration: its chain is publicly trusted by Node.
# Only set DATABASE_SSL_CA for a provider with a private CA (PEM path or inline PEM).
# DATABASE_URL=postgres://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/borynx
# DATABASE_POOL_MAX=10
# DATABASE_SSL_CA=/etc/ssl/certs/provider-ca.pem

# Server-only Storage capability for image/document uploads and document signing after
# Neon authorization. Never prefix with NEXT_PUBLIC_ or VITE_, never commit a value.
# Required only on the Next backend, not in the legacy browser build.
SUPABASE_SERVICE_ROLE_KEY=

# Vite dev/preview server-side /api proxy (never a browser service URL).
BORYNX_API_PROXY_TARGET=http://127.0.0.1:3000

# Better Auth (server-only). Use a cryptographically random >=32-character secret.
# Exact app origin; no trailing path, wildcard or credentials. HTTPS in production.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# Optional comma-separated additional EXACT origins; no wildcards.
BETTER_AUTH_TRUSTED_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Provider-neutral delivery: disabled (default), file (explicit loopback dev), gateway.
EMAIL_DELIVERY_MODE=disabled
EMAIL_GATEWAY_URL=
EMAIL_API_KEY=
EMAIL_FROM=
# Owner-invoked development tools. Never designate data you need to preserve.
BORYNX_ENVIRONMENT=
BORYNX_DEV_DATABASE_NAME=
BORYNX_ALLOW_DEV_RESET=false
BORYNX_ALLOW_DEV_SEED=false
BORYNX_ENABLE_DEMO_LOGIN=false
BORYNX_DEMO_PASSWORD=

# Owner tooling: local (default) OR explicitly designated disposable Neon data.
# Neon owner tools require the DIRECT endpoint (no -pooler), verified TLS, and
# exact host/database/user matches. This does NOT change the app's Neon pool/TLS.
BORYNX_DEV_DATABASE_TARGET=local
BORYNX_DEV_DATABASE_HOST=
BORYNX_DEV_DATABASE_USER=
BORYNX_ALLOW_NEON_DEV_DATA=false
BORYNX_DEV_DATA_DISPOSABLE=false
