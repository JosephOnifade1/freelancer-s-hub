# Borynx environment variables
#
# Two builds share this repository:
#   - Vite app (npm run dev / npm run build)  -> VITE_* variables
#   - Next.js App Router (npm run dev:next)   -> NEXT_PUBLIC_* variables
# Public Auth variables use build prefixes; server credentials MUST NOT.
#
# Supabase Auth/Storage public credentials (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Auth/Storage public credentials (Vite)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Deprecated flags: true only logs a warning; mock database/identities are retired.
NEXT_PUBLIC_DEMO_MODE=false
VITE_DEMO_MODE=false

# Neon PostgreSQL (server-only, Phase 2B.1)
#
# NOT prefixed NEXT_PUBLIC_ / VITE_: this is a database credential and must
# never reach the browser bundle. Leave it unset for unconfigured
# builds — the app then reports "database not configured" instead of failing.
# Use the pooled connection string (`-pooler` host) on serverless deployments.
# Local development: any PostgreSQL, e.g. postgres://user:pass@127.0.0.1:5432/borynx
#
# TLS: remote hosts are ALWAYS certificate-verified. Any sslmode / sslrootcert /
# sslcert parameter in this URL is ignored (stripped) so it cannot weaken that.
# Neon needs no extra configuration: its chain is publicly trusted by Node.
# Only set DATABASE_SSL_CA for a provider with a private CA (PEM path or inline PEM).
# DATABASE_URL=postgres://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/borynx
# DATABASE_POOL_MAX=10
# DATABASE_SSL_CA=/etc/ssl/certs/provider-ca.pem

# Server-only Storage capability for private document verification/signing after
# Neon authorization. Never prefix with NEXT_PUBLIC_ or VITE_, never commit a value.
# Required only on the Next backend, not in the legacy browser build.
SUPABASE_SERVICE_ROLE_KEY=

# Vite dev/preview server-side /api proxy (never a browser service URL).
BORYNX_API_PROXY_TARGET=http://127.0.0.1:3000
